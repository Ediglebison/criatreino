# Banco de dados PostgreSQL
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/criaotreino?schema=public"

# Segredo da sessão JWT (openssl rand -base64 32)
AUTH_SECRET=""

# OpenAI — sem chave, o gerador usa modo simulado (regras locais)
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# Opcional: endpoint compatível com a API da OpenAI (Groq, OpenRouter,
# Gemini, Ollama local, LM Studio...). Vazio = api.openai.com.
# OPENAI_BASE_URL="https://api.groq.com/openai/v1"

NEXT_PUBLIC_APP_URL="http://localhost:3000"
