# --- Faturamento (Stripe) -------------------------------------------------
# Sem chaves, a UI esconde os planos e /api/billing/checkout responde 503
# billingDisabled — o app funciona normalmente no modo gratuito.
STRIPE_SECRET_KEY=""            # sk_live_... / sk_test_...
STRIPE_WEBHOOK_SECRET=""        # whsec_... (do endpoint de webhook)

# Um preço recorrente mensal por plano pago (produto/preço no Stripe, BRL).
# Preencha só os planos que quiser liberar; sem preço o plano não aparece.
STRIPE_PRICE_ID_BASIC=""        # R$ 8,90/mês   → 20 gerações
STRIPE_PRICE_ID_PRO=""          # R$ 29,90/mês  → 100 gerações
STRIPE_PRICE_ID_ULTIMATE=""     # R$ 119,90/mês → 500 gerações

# Limites mensais por plano (padrão: 3 free / 20 basic / 100 pro / 500 ultimate).
# BILLING_FREE_MONTHLY_LIMIT=3
# BILLING_BASIC_MONTHLY_LIMIT=20
# BILLING_PRO_MONTHLY_LIMIT=100
# BILLING_ULTIMATE_MONTHLY_LIMIT=500

# Tamanho do pool de conexões por instância (padrão: 5). Opcional.
# PG_POOL_MAX=5
