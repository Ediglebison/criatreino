# Banco de dados PostgreSQL
# Em produção (Neon/Supabase/RDS) use ?sslmode=require — provedores gerenciados
# recusam conexão em claro.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/criaotreino?schema=public"

# Segredo da sessão JWT (mín. 32 chars; openssl rand -base64 48)
AUTH_SECRET=""

# OpenAI — sem chave, o gerador usa modo simulado (regras locais)
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# Opcional: endpoint compatível com a API da OpenAI (Groq, OpenRouter,
# Gemini, Ollama local, LM Studio...). Vazio = api.openai.com.
# OPENAI_BASE_URL="https://api.groq.com/openai/v1"

NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Faturamento (Stripe) -------------------------------------------------
# Sem chaves, o botão de upgrade some e /api/billing/checkout responde 503
# billingDisabled — o app funciona normalmente no modo gratuito.
STRIPE_SECRET_KEY=""            # sk_live_... / sk_test_...
STRIPE_PRICE_ID=""              # preço recorrente (mensal) do plano PRO
STRIPE_WEBHOOK_SECRET=""        # whsec_... (do endpoint de webhook)

# Limites mensais por plano (padrão: 3 free / 500 pro). Opcional.
# BILLING_FREE_MONTHLY_LIMIT=3
# BILLING_PRO_MONTHLY_LIMIT=500

# Tamanho do pool de conexões por instância (padrão: 5). Opcional.
# PG_POOL_MAX=5
